# --- Database -------------------------------------------------------------
# Works with both `npm run db:up` (Docker) and `npm run db:start` (embedded Postgres).
DATABASE_URL="postgresql://stocksense:stocksense@localhost:5432/stocksense?schema=public"
# Used only by the Vitest suite. It is wiped between tests.
TEST_DATABASE_URL="postgresql://stocksense:stocksense@localhost:5432/stocksense_test?schema=public"

# --- HTTP -----------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# --- Auth -----------------------------------------------------------------
# Use a long random string in any shared environment.
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# --- Email (optional) ------------------------------------------------------
# If SMTP_HOST is empty, password-reset OTPs are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="StockSense <no-reply@stocksense.dev>"
